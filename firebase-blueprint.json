{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "office": { "type": "string" },
        "country": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "Operational task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "country": { "type": "string" },
        "office": { "type": "string" },
        "team": { "type": "string" },
        "owner": { "type": "string" },
        "shift": { "type": "string", "enum": ["Morning", "Mid", "Night"] },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["Backlog", "In Progress", "Waiting", "Blocked", "Done"] },
        "due": { "type": "string" },
        "campaign": { "type": "string" },
        "details": { "type": "string" },
        "carry": { "type": "boolean" },
        "dod": { "type": "array", "items": { "type": "string" } },
        "reminders": { 
          "type": "array", 
          "items": { 
            "type": "object",
            "properties": {
              "time": { "type": "string" },
              "triggered": { "type": "boolean" },
              "label": { "type": "string" }
            }
          }
        },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "creatorId": { "type": "string" }
      },
      "required": ["title", "status", "priority", "createdAt", "updatedAt", "creatorId"]
    },
    "Handover": {
      "title": "Handover",
      "description": "Shift handover record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "fromShift": { "type": "string", "enum": ["Morning", "Mid", "Night"] },
        "toShift": { "type": "string", "enum": ["Morning", "Mid", "Night"] },
        "fromOffice": { "type": "string" },
        "toOffice": { "type": "string" },
        "outgoing": { "type": "string" },
        "incoming": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Acknowledged"] },
        "watchouts": { "type": "string" },
        "taskIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "ackAt": { "type": "string" },
        "creatorId": { "type": "string" }
      },
      "required": ["date", "fromShift", "toShift", "status", "createdAt", "creatorId"]
    },
    "Office": {
      "title": "Office",
      "description": "Hub presence location",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "country": { "type": "string" },
        "lead": { "type": "string" },
        "shift": { "type": "string", "enum": ["Morning", "Mid", "Night"] }
      },
      "required": ["name", "country", "lead", "shift"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "System operational logs",
      "type": "object",
      "properties": {
        "action": { "type": "string" },
        "details": { "type": "object" },
        "userId": { "type": "string" },
        "userEmail": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["action", "userId", "timestamp"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Global tasks collection"
    },
    "/handovers/{handoverId}": {
      "schema": "Handover",
      "description": "Shift handovers collection"
    },
    "/offices/{officeId}": {
      "schema": "Office",
      "description": "Office registry collection"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "System audit logs"
    },
    "/settings/{settingId}": {
      "schema": { "type": "object", "properties": { "name": { "type": "string" } } },
      "description": "Global system settings"
    }
  }
}
