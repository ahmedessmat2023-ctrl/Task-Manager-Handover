{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "office": { "type": "string" },
        "country": { "type": "string" },
        "email": { "type": "string" }
      },
      "required": ["name", "email"]
    },
    "Task": {
      "title": "Task",
      "description": "Operational task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "country": { "type": "string" },
        "office": { "type": "string" },
        "team": { "type": "string" },
        "owner": { "type": "string" },
        "shift": { "type": "string", "enum": ["Morning", "Mid", "Night"] },
        "priority": { "type": "string", "enum": ["Low", "Medium", "High"] },
        "status": { "type": "string", "enum": ["Backlog", "In Progress", "Waiting", "Blocked", "Done"] },
        "due": { "type": "string" },
        "campaign": { "type": "string" },
        "details": { "type": "string" },
        "carry": { "type": "boolean" },
        "dod": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "creatorId": { "type": "string" }
      },
      "required": ["title", "status", "priority", "createdAt", "updatedAt", "creatorId"]
    },
    "Handover": {
      "title": "Handover",
      "description": "Shift handover record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "date": { "type": "string" },
        "fromShift": { "type": "string", "enum": ["Morning", "Mid", "Night"] },
        "toShift": { "type": "string", "enum": ["Morning", "Mid", "Night"] },
        "fromOffice": { "type": "string" },
        "toOffice": { "type": "string" },
        "outgoing": { "type": "string" },
        "incoming": { "type": "string" },
        "status": { "type": "string", "enum": ["Pending", "Acknowledged"] },
        "watchouts": { "type": "string" },
        "taskIds": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string" },
        "ackAt": { "type": "string" },
        "creatorId": { "type": "string" }
      },
      "required": ["date", "fromShift", "toShift", "status", "createdAt", "creatorId"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profile collection"
    },
    "/tasks/{taskId}": {
      "schema": "Task",
      "description": "Global tasks collection"
    },
    "/handovers/{handoverId}": {
      "schema": "Handover",
      "description": "Shift handovers collection"
    }
  }
}
